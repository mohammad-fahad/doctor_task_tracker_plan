# Local development may call the API directly.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# Server-only API origin used by Next.js rewrite. In Vercel, set this to the
# API production origin (for example, https://api.example.vercel.app).
API_UPSTREAM_ORIGIN=http://localhost:4000
# Must match the API's COOKIE_NAME. Used server-side by the auth proxy.
COOKIE_NAME=dt_token
