NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/doctor_tracker
JWT_SECRET=replace-with-strong-secret-at-least-16-chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=dt_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:3000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
# Optional: isolated database URI used by integration tests (never production).
MONGODB_URI_TEST=mongodb://localhost:27017/doctor_tracker_test
# Production opt-ins are supplied only in a trusted local shell when needed.
# Never set these in Vercel or application runtime environments.
# UAT_SEED_ALLOW_PRODUCTION=true
# UAT_SEED_DATABASE=<exact-database-name>
# UAT_SEED_RESET_PASSWORD=true
# UAT_SEED_RESET_DEMO=true
